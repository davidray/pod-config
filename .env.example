# Copy to .env (git-ignored, chmod 600) or export these in your shell.
# Environment variables take precedence over this file.

# Required: Runpod API key with read/write access to Pods, network volumes,
# catalog and billing. https://console.runpod.io/user/settings -> API Keys
RUNPOD_API_KEY=

# Strongly recommended: a SEPARATE restricted Runpod key the pod uses only to
# stop itself on idle/spend/session limits. Runpod's injected pod-scoped key
# gets HTTP 403 on its own pod, so without this only the local guard (which
# needs this machine awake) can enforce shutdown. Give it the least access the
# console allows that still permits pod stop/terminate. It is visible in the
# pod's environment to anyone with access to your Runpod account.
RUNPOD_SELF_STOP_API_KEY=

# Optional: the pinned model (Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8) is not gated.
# A token only raises Hugging Face download rate limits. Read-only scope is enough.
HF_TOKEN=

# Optional overrides
# QWEN_STATE_DIR=~/.local/state/qwenbench     # live sessions, overrides, event log
# QWEN_RESULTS_DIR=./results                   # benchmark output
# QWEN_BENCH_HOME=/path/to/this/repo           # if `qwen` cannot locate the repo
