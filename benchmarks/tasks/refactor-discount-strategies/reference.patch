@@ -0,0 +1,34 @@
+"""Discount strategies, keyed by Discount.kind."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from decimal import Decimal
+
+from ledgerlite.models import Invoice
+from ledgerlite.money import Money
+
+Strategy = Callable[[Invoice, Money], Money]
+
+
+def percent(invoice: Invoice, base: Money) -> Money:
+    d = invoice.discount
+    if not (Decimal("0") <= d.value <= Decimal("100")):
+        raise ValueError("percent discount must be between 0 and 100")
+    return base.times(d.value / Decimal("100")).rounded()
+
+
+def fixed(invoice: Invoice, base: Money) -> Money:
+    amount = Money(invoice.discount.value, invoice.currency)
+    # A fixed discount can never exceed the invoice amount.
+    return amount if amount.amount <= base.amount else base
+
+
+def bulk(invoice: Invoice, base: Money) -> Money:
+    d = invoice.discount
+    if invoice.total_quantity() >= d.min_quantity:
+        return base.times(d.value / Decimal("100")).rounded()
+    return Money.zero(invoice.currency)
+
+
+DISCOUNT_STRATEGIES: dict[str, Strategy] = {"percent": percent, "fixed": fixed, "bulk": bulk}
