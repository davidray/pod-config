diff --git a/src/ledgerlite/exporters/csv_exporter.py b/src/ledgerlite/exporters/csv_exporter.py
new file mode 100644
index 0000000..4b3e17b
--- /dev/null
+++ b/src/ledgerlite/exporters/csv_exporter.py
@@ -0,0 +1,22 @@
+from __future__ import annotations
+
+import csv
+import io
+
+from ledgerlite.exporters.base import invoice_row
+from ledgerlite.models import Invoice
+
+COLUMNS = ("number", "customer", "region", "issued", "due", "status", "currency",
+           "subtotal", "discount", "tax", "total")
+
+
+class CsvExporter:
+    content_type = "text/csv"
+
+    def export(self, invoices: list[Invoice]) -> str:
+        buf = io.StringIO()
+        writer = csv.DictWriter(buf, fieldnames=COLUMNS, lineterminator="\n")
+        writer.writeheader()
+        for inv in invoices:
+            writer.writerow(invoice_row(inv))
+        return buf.getvalue()
