+from datetime import date, timedelta
+
+import pytest
+
+from ledgerlite.models import InvoiceStatus
+from ledgerlite.money import Money
+from ledgerlite.reports import aging_report, bucket_for
+
+AS_OF = date(2026, 6, 30)
+
+
+@pytest.mark.parametrize("days,bucket", [(-5, "current"), (0, "current"), (1, "1-30"), (30, "1-30"),
+                                         (31, "31-60"), (60, "31-60"), (61, "61-90"), (90, "61-90"),
+                                         (91, "90+"), (400, "90+")])
+def test_bucket_boundaries(days, bucket):
+    assert bucket_for(days) == bucket
+
+
+def _inv(factory, number, days_overdue, status=InvoiceStatus.SENT, price="100.00"):
+    return factory(number=number, status=status, due=AS_OF - timedelta(days=days_overdue),
+                   items=[("Svc", 1, price, False)])
+
+
+def test_report_buckets_and_totals(invoice_factory):
+    invoices = [_inv(invoice_factory, "A", 0), _inv(invoice_factory, "B", 30), _inv(invoice_factory, "C", 31),
+                _inv(invoice_factory, "D", 61), _inv(invoice_factory, "E", 91, price="50.00")]
+    r = aging_report(invoices, AS_OF)
+    assert r.invoice_buckets == {"A": "current", "B": "1-30", "C": "31-60", "D": "61-90", "E": "90+"}
+    assert r.buckets["current"] == Money.of("100.00")
+    assert r.buckets["90+"] == Money.of("50.00")
+    assert r.total_outstanding() == Money.of("450.00")
+
+
+@pytest.mark.parametrize("status", [InvoiceStatus.DRAFT, InvoiceStatus.PAID, InvoiceStatus.VOID])
+def test_non_sent_excluded(invoice_factory, status):
+    r = aging_report([_inv(invoice_factory, "X", 10, status=status)], AS_OF)
+    assert r.invoice_buckets == {}
+    assert r.total_outstanding() == Money.of("0")
+
+
+def test_currency_mismatch_rejected(invoice_factory):
+    inv = _inv(invoice_factory, "EUR1", 5)
+    inv.currency = "EUR"
+    with pytest.raises(ValueError, match="EUR1"):
+        aging_report([inv], AS_OF)
